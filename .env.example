# Railway app settings. These are examples, not production secrets.
APP_ENV=production
APP_NAME=RIX STORM PANEL 2.5
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-16-characters
# Optional: existing installations should keep their existing values unchanged.
SECRET_KEY=
DATA_ENCRYPTION_KEY=
# Railway automatically provides PORT and normally RAILWAY_PUBLIC_DOMAIN.
# Set only when you use a custom domain instead of the Railway domain.
PUBLIC_BASE_URL=
DATA_DIR=/data
DATABASE_URL=
SESSION_MAX_AGE_SECONDS=28800
XRAY_BIN=/usr/local/bin/xray
XRAY_LOG_LEVEL=warning
